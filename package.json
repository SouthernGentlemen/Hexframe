{
  "name": "hexframe",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Hexframe — a deterministic 2D fighting-game simulator and combat laboratory on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs --skip-build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run tests/content",
    "secrets:push": "node scripts/sync-secrets.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
