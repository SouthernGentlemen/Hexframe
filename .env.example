# Hexframe — local credential template.
#
# Copy to .dev.vars (NOT .env) for `wrangler dev`: wrangler loads .dev.vars into the
# Worker as bindings, which is the same shape production uses. Both files are ignored.
#
#   cp .env.example .dev.vars
#
# In production these are Cloudflare Worker secrets under the identical names:
#
#   npx wrangler secret put ADMIN_USERNAME
#   npx wrangler secret put ADMIN_PASSWORD
#   npx wrangler secret put ADMIN_SESSION_SECRET
#
# They are read only inside the Worker. None of them is ever sent to the browser, and
# none of them may appear in wrangler.jsonc, in client code, or in any built asset.

ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Cloudflare account id, used by `wrangler deploy`. An account identifier, so it is kept
# out of the tracked wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID=
