{
  // Hexframe Worker. Game routing, player saves, developer authentication, static
  // assets and (from 0.2) match transport. It never decides whether an attack hits:
  // combat is deterministic simulation inside the browser.
  "name": "hexframe",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ENVIRONMENT": "development" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every request passes through the Worker first so save APIs and authenticated
    // Training developer flags are handled before static asset delivery.
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "PLAYER_SAVES", "class_name": "PlayerSaveObject" }]
  },
  "migrations": [{ "tag": "player-saves-v1", "new_sqlite_classes": ["PlayerSaveObject"] }],
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "hexframe",
      "workers_dev": false,
      // account_id is deliberately absent: it is an account identifier and this file is
      // tracked. Supply it as CLOUDFLARE_ACCOUNT_ID in the environment when deploying.
      "routes": [{ "pattern": "hexframe.wizardgang.ai", "custom_domain": true }],
      "vars": { "ENVIRONMENT": "production" },
      "observability": { "enabled": true },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "durable_objects": {
        "bindings": [{ "name": "PLAYER_SAVES", "class_name": "PlayerSaveObject" }]
      }
    }
  }
}
